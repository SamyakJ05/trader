# ── App ─────────────────────────────────────────────────────────────
# Production only, both read by docker-compose.prod.yml. DOMAIN is what Caddy
# requests a certificate for; PUBLIC_API_URL is baked into the web bundle at
# build time, because Next inlines public env vars and they cannot be supplied
# at run time. Both are the same host here: Caddy routes /api to the API and
# everything else to the web app.
#
# PUBLIC_API_URL must carry the /api/v1 suffix: the frontend appends request
# paths to it unchanged, so without it every call 404s.
#   DOMAIN=tickortrade.online
#   PUBLIC_API_URL=https://tickortrade.online/api/v1
DOMAIN=
PUBLIC_API_URL=

APP_SECRET_KEY=change-me-in-prod
# REQUIRED. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts broker session tokens and TOTP secrets at rest. Two-factor setup
# refuses to run without it — a TOTP secret in plaintext would hand anyone with
# database access a permanent second factor for every user. Broker tokens fall
# back to marked plaintext when unset (dev only) since they expire daily.
APP_ENCRYPTION_KEY=
DEBUG=true

# Master gate for real-money orders. Keep false until an adapter is verified.
ENABLE_LIVE_TRADING=false
# Set false to allow paper trading outside NSE market hours.
MARKET_HOURS_ENFORCED=false
# The outbound IP registered with your broker for transactional order requests
# (ICICI's Primary IP Address, and Zerodha's equivalent). Set it and the api
# logs a loud error at startup when this host leaves from a different address,
# which is otherwise only discovered by an order being rejected. Diagnostic
# only — it gates nothing.
BROKER_STATIC_IP=

# Which user may attach each set of broker credentials, as REF:email pairs.
# A credential ref names an env-var prefix (ICICI_MAIN -> ICICI_MAIN_API_KEY),
# so attaching one hands that account's adapter those keys. Only refs listed
# here can be attached, and only by the user named -- otherwise one user could
# name another's ref and read their real broker account. Refs not listed here
# belong to nobody and are refused for everybody.
#   BROKER_CREDENTIAL_OWNERS=ICICI_MAIN:you@example.com,ZERODHA_MAIN:you@example.com
BROKER_CREDENTIAL_OWNERS=

# The reverse proxy's address on the docker network. uvicorn trusts
# X-Forwarded-For only from this peer; trusting it from anyone would let a
# client forge the IP that the login and password-reset rate limits key on.
PROXY_IP=172.17.0.1

# ── Postgres ────────────────────────────────────────────────────────
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader
POSTGRES_DB=trader
DATABASE_URL=postgresql+asyncpg://trader:trader@db:5432/trader
# Connection budget, not a performance dial. Every api worker and the arq
# worker opens its own pool, and managed Postgres caps connections per cluster
# (DigitalOcean's smallest plan allows ~22). Defaults of 3 + 2 keep two api
# workers and one arq worker at 15 when saturated. Raise only alongside the
# plan's limit.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# ── Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── AI trading ──────────────────────────────────────────────────────
# Zero-config fallback: set an Anthropic key here and AI features work for
# every user. Per-user provider settings (Anthropic / OpenAI / OpenRouter /
# Amazon Bedrock) configured on the AI Trading page override this; those
# keys are stored Fernet-encrypted in the database.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# ── Email (Resend) ──────────────────────────────────────────────────
# Invites and password resets. Without a key, messages are written to the
# API log instead of sent — links stay usable in local development, but ONLY
# while DEBUG=true. Outside debug a missing key is a hard error rather than a
# silent fallback, because the console backend writes raw invite tokens to the
# log. Get a key at https://resend.com and verify your sending domain.
RESEND_API_KEY=
EMAIL_FROM=trader <noreply@yourdomain.com>
# How long an invite link stays valid.
INVITE_TTL_HOURS=168

# ── Broker credentials ──────────────────────────────────────────────
# Each broker_account row stores a `credential_ref` (e.g. ZERODHA_MAIN).
# The backend reads <REF>_API_KEY / <REF>_API_SECRET / <REF>_ACCESS_TOKEN
# from the environment. Never put secrets in the database or code.

# Zerodha Kite Connect (https://developers.kite.trade — create app,
# set redirect URL to the value below)
ZERODHA_MAIN_API_KEY=
ZERODHA_MAIN_API_SECRET=
ZERODHA_REDIRECT_URL=http://localhost:8000/api/v1/brokers/zerodha/callback

# Groww Trading API (https://groww.in/trade-api)
GROWW_MAIN_API_KEY=
GROWW_MAIN_API_SECRET=
GROWW_MAIN_ACCESS_TOKEN=

# ICICI Direct Breeze (https://api.icicidirect.com/apiuser/home)
BREEZE_MAIN_API_KEY=
BREEZE_MAIN_API_SECRET=

# ── Frontend ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
